[Unit]
Description=Project work ledger work into Hermes Kanban
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/var/lib/hermes/kanban-surface
Environment=HOME=/var/lib/hermes
Environment=PATH=/var/lib/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_KANBAN_BOARD=kanban-surface
ExecStart=/usr/bin/python3 /var/lib/hermes/kanban-surface/sync/intake_sync.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes
